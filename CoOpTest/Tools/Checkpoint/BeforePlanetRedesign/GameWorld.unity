  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CoopPrototype.Checkpoint.ShopTerminal
  ShowTopMostFoldoutHeaderGroup: 1
  interactionLabel: Interact
  offers:
  - title: 'X-ray belt: second slot'
    description: Adds a second load slot to the cargo X-ray conveyor, so two crates
      are scanned per run. Shared by the crew.
    price: 120
    kind: 1
    prefab: {fileID: 0}
  - title: UV lamp
    description: Genuine IDs show a violet UV watermark under the lamp; forged ones
      don't. Hold it near a document, or keep it in a slot while inspecting an ID.
    price: 80
    kind: 0
    prefab: {fileID: 6174040378091180444, guid: 13b9a6db60b824f42b0aff20da438b7a, type: 3}
  - title: Coffee
    description: Left click to drink. You walk faster for the rest of the day.
    price: 15
    kind: 0
    prefab: {fileID: 97958421955712088, guid: 12ccd766dc2a59a45bb1684cbd00ce39, type: 3}
  dispenser: {fileID: 1919498121}
  scanner: {fileID: 1844745867}
